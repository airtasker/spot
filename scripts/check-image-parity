#!/bin/bash
# Checks that the Docker image behaves identically to the compiled CLI, and that it
# works with no node_modules anywhere near the contract.
#
# The image and the npm package are published from the same source, but they resolve
# their dependencies independently and the image deletes commands the package keeps,
# so nothing else proves a consumer that switches from one to the other gets the same
# result.
#
# Usage: scripts/check-image-parity <image-ref>
set -ue -o pipefail

if [ ${#} -ne 1 ]; then
  echo "Usage: ${0} <image-ref>"
  exit 1
fi

IMAGE="${1}"

cd "$(dirname "${0}")/.."
REPO_ROOT="$(pwd)"

if [ ! -f ./build/cli/src/commands/generate.js ]; then
  echo "ERROR: ./build/cli/src/commands/generate.js is missing. Run 'pnpm build' first." >&2
  exit 1
fi

CONTRACT="test-fixtures/contract/api.ts"
# Under build/ so a single mount covers both trees and build/ is already gitignored.
PARITY_DIR="${REPO_ROOT}/build/parity"
CLI_DIR="${PARITY_DIR}/cli"
IMAGE_DIR="${PARITY_DIR}/image"
rm -rf "${PARITY_DIR}"
mkdir -p "${CLI_DIR}" "${IMAGE_DIR}"

run_cli() {
  node ./bin/run "${@}"
}

run_image() {
  # Mounted at its real absolute path because path arguments are used unresolved, and
  # run as the invoking user so the output is not root-owned.
  docker run --rm \
    --user "$(id -u):$(id -g)" \
    --volume "${REPO_ROOT}:${REPO_ROOT}" \
    --workdir "${PWD}" \
    "${IMAGE}" "${@}"
}

failures=0
fail() {
  echo "FAIL: ${1}" >&2
  failures=$((failures + 1))
}

# --- generators ---------------------------------------------------------------
#
# Read the generator names out of the CLI rather than trusting the matrix below, so a
# generator added there cannot slip through this gate uncompared.
DECLARED=()
while IFS= read -r generator; do
  DECLARED+=("${generator}")
done < <(
  sed -n '/^const generators: Generators = {$/,/^};$/p' cli/src/commands/generate.ts |
    sed -n 's/^  "\{0,1\}\([a-z0-9-]\{1,\}\)"\{0,1\}: {$/\1/p' | sort
)

if [ ${#DECLARED[@]} -eq 0 ]; then
  echo "ERROR: no generators parsed from cli/src/commands/generate.ts." >&2
  echo "The 'const generators' block has probably changed shape; this gate would" >&2
  echo "otherwise pass while comparing nothing." >&2
  exit 1
fi

# generator:language pairs. Kept explicit because the supported languages differ per
# generator, and checked against DECLARED immediately below.
CASES=(
  "json-schema:json"
  "json-schema:yaml"
  "openapi2:json"
  "openapi2:yaml"
  "openapi3:json"
  "openapi3:yaml"
  "raw:json"
)

COVERED="$(printf '%s\n' "${CASES[@]}" | cut -d: -f1 | sort -u | tr '\n' ' ')"
if [ "${COVERED}" != "$(printf '%s ' "${DECLARED[@]}")" ]; then
  echo "ERROR: generator coverage is out of date." >&2
  echo "  declared in the CLI: ${DECLARED[*]}" >&2
  echo "  covered here:        ${COVERED}" >&2
  echo "Add the missing generator's languages to CASES in this script." >&2
  exit 1
fi

echo "== generate: comparing output byte for byte =="
for case in "${CASES[@]}"; do
  generator="${case%%:*}"
  language="${case##*:}"
  args=(generate -c "${CONTRACT}" -g "${generator}" -l "${language}")

  run_cli "${args[@]}" -o "${CLI_DIR}/${generator}-${language}" >/dev/null
  run_image "${args[@]}" -o "${IMAGE_DIR}/${generator}-${language}" >/dev/null
done

if diff --recursive "${CLI_DIR}" "${IMAGE_DIR}"; then
  echo "OK: ${#CASES[@]} generator/language combinations produced identical output."
else
  fail "the image and the compiled CLI generated different output"
fi

# --- exit code and stdout parity ----------------------------------------------
#
# Both sides run with the same working directory and the same mount path, so the
# absolute paths these commands print are expected to match exactly. A difference is
# a real difference, not a rendering artefact.
compare_run() {
  local label="${1}"
  shift
  local cli_out image_out cli_status image_status

  set +e
  cli_out="$(run_cli "${@}" 2>&1)"
  cli_status=$?
  image_out="$(run_image "${@}" 2>&1)"
  image_status=$?
  set -e

  if [ "${cli_status}" -ne "${image_status}" ]; then
    fail "${label}: exit ${cli_status} from the CLI, ${image_status} from the image"
    return
  fi
  if [ "${cli_out}" != "${image_out}" ]; then
    fail "${label}: output differs"
    diff <(echo "${cli_out}") <(echo "${image_out}") >&2 || true
    return
  fi
  echo "OK: ${label} (exit ${cli_status}, identical output)"
}

echo "== validate, lint, ts-lint: comparing exit code and output =="
compare_run "validate" validate "${CONTRACT}"
compare_run "lint" lint "${CONTRACT}"
# The severity flag bff-client passes; it must keep behaving the same in the image.
compare_run "lint --no-trailing-forward-slash=error" \
  lint "${CONTRACT}" --no-trailing-forward-slash=error
compare_run "ts-lint clean" ts-lint test-fixtures/ts-lint/clean
compare_run "ts-lint dirty" ts-lint test-fixtures/ts-lint/dirty
# A command that fails through oclif's own error path, which is a different exit
# route from ts-lint's. Without it this gate passes on an image where every failing
# command exits 0 — see the HOME line in the Dockerfile for how that happens.
compare_run "validate an invalid contract" \
  validate lib/src/__spec-examples__/contract-with-type-error.ts

# --- self-containment ---------------------------------------------------------
#
# The regression this whole image depends on: Spot used to need the consumer's
# node_modules to resolve a contract's own `import ... from "@airtasker/spot"`. Run it
# somewhere that has no node_modules on any parent path, which the repo checkout does
# not prove.
echo "== self-containment: no node_modules on any parent path =="
SCRATCH="$(mktemp -d)"
trap 'rm -rf "${SCRATCH}"' EXIT
cp test-fixtures/contract/*.ts "${SCRATCH}/"

parent="${SCRATCH}"
while [ "${parent}" != "/" ]; do
  if [ -d "${parent}/node_modules" ]; then
    echo "ERROR: ${parent}/node_modules exists, so this check proves nothing." >&2
    exit 1
  fi
  parent="$(dirname "${parent}")"
done

if docker run --rm \
  --user "$(id -u):$(id -g)" \
  --volume "${SCRATCH}:${SCRATCH}" \
  --workdir "${SCRATCH}" \
  "${IMAGE}" generate -c api.ts -g openapi3 -l yaml -o . >/dev/null &&
  [ -f "${SCRATCH}/api.yml" ]; then
  echo "OK: generated from a directory with no node_modules above it."
else
  fail "the image could not process a contract outside a Node project"
fi

# --- validation-server --------------------------------------------------------
#
# Long-running, port-bound, and read by a machine: bff-client's Gradle ExecFork task
# blocks on the readiness line. It has to appear on stdout without a TTY, which is
# what `docker run -d` and `docker logs` reproduce.
echo "== validation-server: readiness line, port bind, teardown =="
SERVER_NAME="spot-parity-validation-server"
docker rm -f "${SERVER_NAME}" >/dev/null 2>&1 || true

docker run --detach --name "${SERVER_NAME}" \
  --user "$(id -u):$(id -g)" \
  --volume "${REPO_ROOT}:${REPO_ROOT}" \
  --workdir "${PWD}" \
  --publish 5600:5600 \
  "${IMAGE}" validation-server "${CONTRACT}" -p 5600 >/dev/null

server_ready=0
for _ in $(seq 1 60); do
  if docker logs "${SERVER_NAME}" 2>&1 | grep -q "Validation server running"; then
    server_ready=1
    break
  fi
  sleep 1
done

if [ "${server_ready}" -eq 1 ]; then
  echo "OK: readiness line reached stdout without a TTY."
  if curl -fsS -o /dev/null "http://localhost:5600/health"; then
    echo "OK: published port answers /health."
  else
    fail "validation-server did not answer on the published port"
  fi
else
  fail "validation-server never printed its readiness line"
  docker logs "${SERVER_NAME}" >&2 || true
fi

docker rm -f "${SERVER_NAME}" >/dev/null

# --- commands the image does not carry ----------------------------------------
#
# mock, docs and init stay npm-only. Their compiled files are deleted from the image,
# and no oclif manifest is shipped, so nothing can still advertise them.
echo "== mock, docs and init are absent =="
for command in mock docs init; do
  set +e
  output="$(run_image "${command}" "${CONTRACT}" 2>&1)"
  status=$?
  set -e
  if [ "${status}" -eq 0 ]; then
    fail "${command} ran in the image; it is supposed to be npm-only"
  elif ! grep -qi "not found" <<<"${output}"; then
    fail "${command} failed for the wrong reason: ${output}"
  else
    echo "OK: ${command} is not a command in the image."
  fi
done

echo ""
if [ "${failures}" -ne 0 ]; then
  echo "${failures} check(s) failed. The image is not a drop-in replacement for the npm package at this commit." >&2
  exit 1
fi
echo "All checks passed."
